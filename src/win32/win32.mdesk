////////////////////////////////
//~ rjf: Exception Codes

@table(name lower_name code default display_string)
W32_ExceptionCodeKindTable:
{
  {CtrlC                          ctrl_c                                0x40010005  1  "Control-C"                                              }
  {CtrlBreak                      ctrl_break                            0x40010008  1  "Control-Break"                                          }
  {WinRTOriginateError            win_rt_originate_error                0x40080201  0  "WinRT Originate Error"                                  }
  {WinRTTransformError            win_rt_transform_error                0x40080202  0  "WinRT Transform Error"                                  }
  {RPCCallCancelled               rpc_call_cancelled                    0x0000071a  0  "RPC Call Cancelled"                                     }
  {DatatypeMisalignment           datatype_misalignment                 0x80000002  0  "Data Type Misalignment"                                 }
  {AccessViolation                access_violation                      0xc0000005  1  "Access Violation"                                       }
  {InPageError                    in_page_error                         0xc0000006  0  "In Page Error"                                          }
  {InvalidHandle                  invalid_handle                        0xc0000008  1  "Invalid Handle Specified"                               }
  {NotEnoughQuota                 not_enough_quota                      0xc0000017  0  "Not Enough Quota"                                       }
  {IllegalInstruction             illegal_instruction                   0xc000001d  0  "Illegal Instruction"                                    }
  {CannotContinueException        cannot_continue_exception             0xc0000025  0  "Cannot Continue From Exception"                         }
  {InvalidExceptionDisposition    invalid_exception_disposition         0xc0000026  0  "Invalid Exception Disposition Returned By Handler"      }
  {ArrayBoundsExceeded            array_bounds_exceeded                 0xc000008c  0  "Array Bounds Exceeded"                                  }
  {FloatingPointDenormalOperand   floating_point_denormal_operand       0xc000008d  0  "Floating-Point Denormal Operand"                        }
  {FloatingPointDivisionByZero    floating_point_division_by_zero       0xc000008e  0  "Floating-Point Division By Zero"                        }
  {FloatingPointInexactResult     floating_point_inexact_result         0xc000008f  0  "Floating-Point Inexact Result"                          }
  {FloatingPointInvalidOperation  floating_point_invalid_operation      0xc0000090  0  "Floating-Point Invalid Operation"                       }
  {FloatingPointOverflow          floating_point_overflow               0xc0000091  0  "Floating-Point Overflow"                                }
  {FloatingPointStackCheck        floating_point_stack_check            0xc0000092  0  "Floating-Point Stack Check"                             }
  {FloatingPointUnderflow         floating_point_underflow              0xc0000093  0  "Floating-Point Underflow"                               }
  {IntegerDivisionByZero          integer_division_by_zero              0xc0000094  0  "Integer Division By Zero"                               }
  {IntegerOverflow                integer_overflow                      0xc0000095  0  "Integer Overflow"                                       }
  {PrivilegedInstruction          privileged_instruction                0xc0000096  0  "Privileged Instruction"                                 }
  {StackOverflow                  stack_overflow                        0xc00000fd  0  "Stack Overflow"                                         }
  {UnableToLocateDLL              unable_to_locate_dll                  0xc0000135  0  "Unable To Locate DLL"                                   }
  {OrdinalNotFound                ordinal_not_found                     0xc0000138  0  "Ordinal Not Found"                                      }
  {EntryPointNotFound             entry_point_not_found                 0xc0000139  0  "Entry Point Not Found"                                  }
  {DLLInitializationFailed        dll_initialization_failed             0xc0000142  0  "DLL Initialization Failed"                              }
  {FloatingPointSSEMultipleFaults floating_point_sse_multiple_faults    0xc00002b4  0  "Floating Point SSE Multiple Faults"                     }
  {FloatingPointSSEMultipleTraps  floating_point_sse_multiple_traps     0xc00002b5  0  "Floating Point SSE Multiple Traps"                      }
  {AssertionFailed                assertion_failed                      0xc0000420  1  "Assertion Failed"                                       }
  {ModuleNotFound                 module_not_found                      0xc06d007e  0  "Module Not Found"                                       }
  {ProcedureNotFound              procedure_not_found                   0xc06d007f  0  "Procedure Not Found"                                    }
  {SanitizerErrorDetected         sanitizer_error_detected              0xe073616e  1  "Sanitizer Error Detected"                               }
  {SanitizerRawAccessViolation    sanitizer_raw_access_violation        0xe0736171  0  "Sanitizer Raw Access Violation"                         }
  {DirectXDebugLayer              directx_debug_layer                   0x0000087a  1  "DirectX Debug Layer"                                    }
}

@enum W32_ExceptionCodeKind:
{
  Null,
  @expand(W32_ExceptionCodeKindTable a) `$(a.name)`,
  COUNT,
}

@data(U32) w32_exception_code_kind_code_table:
{
  `0`;
  @expand(W32_ExceptionCodeKindTable a) `$(a.code)`;
}

@data(String8) w32_exception_code_kind_display_string_table:
{
  `{0}`;
  @expand(W32_ExceptionCodeKindTable a) `str8_lit_comp("$(a.display_string)")`;
}

@data(String8) w32_exception_code_kind_lowercase_code_string_table:
{
  `{0}`;
  @expand(W32_ExceptionCodeKindTable a) `str8_lit_comp("$(a.lower_name)")`;
}

@data(B8) w32_exception_code_kind_default_enable_table:
{
  `0`;
  @expand(W32_ExceptionCodeKindTable a) `$(a.default)`;
}

