////////////////////////////////
//~ rjf: Built-In Command Tables

@table(name                      ui_vis   ipc_docs_vis   q_expr                       q_slot       q_allow_files q_allow_folders  q_keep_oi   q_select_oi  q_is_code  q_floating  q_required               canonical_icon        string    display_name                                  desc                                                                                                               search_tags                      filter_tags)
//    /                          |        |              |                            |             \__                      ______________________________________________________________/              /                     /          |                                             |                                                                                                                  |                                |
//   /                           |        |              |                            |                \                    /                                                           _________________/    _________________/           |                                             |                                                                                                                  |                                |
D_CmdTable:     //               |        |              |                            |                 |                  |                                                           /                     /                             |                                             |                                                                                                                  |                                |
{
  //- rjf: low-level target control operations
  {LaunchAndRun                   1        1              "query:targets"              Cfg                0  0  0  0  0  1  1                                                           Play                  "launch_and_run"              "Launch and Run"                              "Starts debugging a new instance of a target, then runs."                                                          "launch,start,run,target"        ""                                                                                            }
  {LaunchAndStepInto              1        1              "query:targets"              Cfg                0  0  0  0  0  1  1                                                           PlayStepForward       "launch_and_step_into"        "Launch and Step Into"                        "Starts debugging a new instance of a target, then stops at the program's entry point."                            "launch,start,entry,point"       ""                                                                                            }
  {Kill                           1        1              "query:processes"            Process            0  0  0  0  0  1  1                                                           X                     "kill"                        "Kill"                                        "Kills the specified existing attached process(es)."                                                               "stop,kill"                      ""                                                                                            }
  {KillAll                        1        1              ""                           Null               0  0  0  0  0  0  0                                                           Stop                  "kill_all"                    "Kill All"                                    "Kills all attached processes."                                                                                    "stop,kill,all"                  ""                                                                                            }
  {Detach                         1        1              "query:processes"            Process            0  0  0  0  0  1  1                                                           Null                  "detach"                      "Detach"                                      "Detaches the specified attached process(es)."                                                                     "detach"                         ""                                                                                            }
  {Continue                       1        1              ""                           Null               0  0  0  0  0  0  0                                                           Play                  "continue"                    "Continue"                                    "Continues executing all attached processes."                                                                      ""                               ""                                                                                            }
  {StepIntoInst                   1        1              ""                           Null               0  0  0  0  0  0  0                                                           StepInto              "step_into_inst"              "Step Into (Assembly)"                        "Performs a step that goes into calls, at the instruction level."                                                  "single,step,thread"             ""                                                                                            }
  {StepOverInst                   1        1              ""                           Null               0  0  0  0  0  0  0                                                           StepOver              "step_over_inst"              "Step Over (Assembly)"                        "Performs a step that skips calls, at the instruction level."                                                      "single,step,thread"             ""                                                                                            }
  {StepIntoLine                   1        1              ""                           Null               0  0  0  0  0  0  0                                                           StepInto              "step_into_line"              "Step Into (Line)"                            "Performs a step that goes into calls, at the source code line level."                                             "step,thread"                    ""                                                                                            }
  {StepOverLine                   1        1              ""                           Null               0  0  0  0  0  0  0                                                           StepOver              "step_over_line"              "Step Over (Line)"                            "Performs a step that skips calls, at the source code line level."                                                 "step,thread"                    ""                                                                                            }
  {StepOut                        1        1              ""                           Null               0  0  0  0  0  0  0                                                           StepOut               "step_out"                    "Step Out"                                    "Runs to the first instruction after the current scope is exited."                                                 ""                               ""                                                                                            }
  {StepToExit                     1        1              ""                           Null               0  0  0  0  0  0  0                                                           StepOut               "step_to_exit"                "Step To Exit"                                "Runs to the first encountered instruction which will exit the current scope."                                     ""                               ""                                                                                            }
  {Halt                           1        1              ""                           Null               0  0  0  0  0  0  0                                                           Pause                 "halt"                        "Halt"                                        "Halts all attached processes."                                                                                    "pause"                          ""                                                                                            }
  {SoftHaltRefresh                0        0              ""                           Null               0  0  0  0  0  0  0                                                           Refresh               "soft_halt_refresh"           "Soft Halt Refresh"                           "Interrupts all attached processes to collect data, and then resumes them."                                        ""                               ""                                                                                            }
  {SetThreadIP                    0        1              ""                           Vaddr              0  0  0  0  1  1  1                                                           Null                  "set_thread_ip"               "Set Thread IP"                               "Sets the specified thread's instruction pointer at the specified address."                                        ""                               ""                                                                                            }
  
  //- rjf: high-level composite target control operations
  {RunToLine                      1        1              ""                           Null               0  0  0  0  0  0  0                                                           Play                  "run_to_line"                 "Run To Line"                                 "Runs until a particular source line is hit."                                                                      ""                               "{text_pt_commands}{disasm_pt_commands}"                                                      }
  {RunToName                      1        1              "query:procedures"           String             0  0  0  0  0  1  1                                                           Play                  "run_to_name"                 "Run To Name"                                 "Runs until a particular symbol name is hit."                                                                      ""                               ""                                                                                            }
  {Run                            1        1              ""                           Null               0  0  0  0  0  0  0                                                           Play                  "run"                         "Run"                                         "Runs all targets after starting them if they have not been started yet."                                          "play"                           ""                                                                                            }
  {Restart                        1        1              ""                           Null               0  0  0  0  0  0  0                                                           Redo                  "restart"                     "Restart"                                     "Kills all attached processes, then launches all active targets."                                                  "restart,retry"                  ""                                                                                            }
  {StepInto                       1        1              ""                           Null               0  0  0  0  0  0  0                                                           StepInto              "step_into"                   "Step Into"                                   "Steps once, possibly into function calls, for either source lines or instructions (whichever is selected)."       ""                               ""                                                                                            }
  {StepOver                       1        1              ""                           Null               0  0  0  0  0  0  0                                                           StepOver              "step_over"                   "Step Over"                                   "Steps once, always over function calls, for either source lines or instructions."                                 ""                               ""                                                                                            }
  
  //- rjf: debug control context management operations
  {FreezeThread                   1        1              "query:threads"              Thread             0  0  0  0  0  1  1                                                           Locked                "freeze_thread"               "Freeze Thread"                               "Freezes the passed thread."                                                                                       "callstack,unwind"               ""                                                                                            }
  {ThawThread                     1        1              "query:threads"              Thread             0  0  0  0  0  1  1                                                           Unlocked              "thaw_thread"                 "Thaw Thread"                                 "Thaws the passed thread."                                                                                         ""                               ""                                                                                            }
  {FreezeProcess                  1        1              "query:processes"            Process            0  0  0  0  0  1  1                                                           Locked                "freeze_process"              "Freeze Process"                              "Freezes the passed process."                                                                                      ""                               ""                                                                                            }
  {ThawProcess                    1        1              "query:processes"            Process            0  0  0  0  0  1  1                                                           Unlocked              "thaw_process"                "Thaw Process"                                "Thaws the passed process."                                                                                        ""                               ""                                                                                            }
  {FreezeServer                   0        1              "query:servers"              Server             0  0  0  0  0  1  1                                                           Locked                "freeze_server "              "Freeze Server "                              "Freezes the passed server."                                                                                       ""                               ""                                                                                            }
  {ThawServer                     0        1              "query:servers"              Server             0  0  0  0  0  1  1                                                           Unlocked              "thaw_server"                 "Thaw Server"                                 "Thaws the passed server."                                                                                         ""                               ""                                                                                            }
  {FreezeLocalServer              1        1              ""                           Null               0  0  0  0  0  0  0                                                           Machine               "freeze_local_server"         "Freeze Local Server"                         "Freezes the local server."                                                                                        ""                               ""                                                                                            }
  {ThawLocalServer                1        1              ""                           Null               0  0  0  0  0  0  0                                                           Machine               "thaw_local_server"           "Thaw Local Server"                           "Thaws the local server."                                                                                          ""                               ""                                                                                            }
  {FreezeEntity                   0        0              ""                           Null               0  0  0  0  0  0  0                                                           Unlocked              "freeze_entity"               "Freeze Entity"                               "Freezes an entity."                                                                                               ""                               ""                                                                                            }
  {ThawEntity                     0        0              ""                           Null               0  0  0  0  0  0  0                                                           Locked                "thaw_entity"                 "Thaw Entity"                                 "Thaws an entity."                                                                                                 ""                               ""                                                                                            }
  
  //- rjf: entity decoration
  {SetEntityColor                 0        0              ""                           Null               0  0  0  0  0  0  0                                                           Null                  "set_entity_color"            "Set Entity Color"                            "Sets the passed entity's color."                                                                                  ""                               ""                                                                                            }
  {SetEntityName                  0        0              ""                           Null               0  0  0  0  0  0  0                                                           Null                  "set_entity_name"             "Set Entity Name"                             "Sets the passed entity's name."                                                                                   ""                               ""                                                                                            }
  
  //- rjf: modules
  {DownloadModuleDebugInfo        1        1              "query:modules"              CtrlEntity         0  0  0  0  0  1  1                                                           Module                "download_module_debug_info"  "Download Module Debug Info"                  "Tries to download a module's debug info from symbol server(s)."                                                   ""                               "{module_commands}"                                                                           }
  
  //- rjf: attaching
  {Attach                         1        1              "query:unattached_processes" PID                0  0  0  0  0  1  1                                                           Null                  "attach"                      "Attach"                                      "Attaches to a process that is already running on the local machine."                                              ""                               ""                                                                                            }
  
  //- rjf: crash dump opening
  {OpenCrashDump                  1        1              `folder:\\"$input\\"`        FilePath           0  0  0  0  0  1  1                                                           FileOutline           "open_crash_dump"             "Open Crash Dump"                             "Opens a crash dump file and recreates debuggee state at the time of the crash."                                   ""                               ""                                                                                            }
  
  //- rjf: remote debug server connecting
  {OpenRemoteServer               1        1              ""                           String             0  0  0  0  0  1  1                                                           Machine               "open_remote_server"          "Open Remote Server"                          "Opens a remote debug server by IP address."                                                                       ""                               ""                                                                                            }
  {CloseRemoteServer              1        1              "query:servers"              CtrlEntity         0  0  0  0  0  1  1                                                           Machine               "close_remote_server"         "Close Remote Server"                         "Closes a remote debug server."                                                                                    ""                               ""                                                                                            }
}

@enum D_CmdKind:
{
  Null,
  @expand(D_CmdTable, a) `$(a.name)`,
  COUNT,
}

////////////////////////////////
//~ rjf: Developer Toggles

@table(name)
D_DevToggleTable:
{
  {always_refresh}
  {simulate_lag}
  {draw_ui_text_pos}
  {draw_ui_focus_debug}
  {draw_ui_box_heatmap}
  {eval_compiler_tooltips}
  {eval_watch_key_tooltips}
  {cmd_context_tooltips}
  {updating_indicator}
}

@gen
{
  @expand(D_DevToggleTable a) `global B32 DEV_$(a.name) = 0;`
}

@gen
{
  `struct {B32 *value_ptr; String8 name;} DEV_toggle_table[] =`;
  `{`;
    @expand(D_DevToggleTable a) `{&DEV_$(a.name), str8_lit_comp("$(a.name)")},`
      `};`;
}

////////////////////////////////
//~ rjf: Entity Kinds

@table(name  code_name  display_string)
D_EntityKindTable:
{
  {Root                      root                      "Root"                      }
  {Server                    server                    "Server"                    }
  {Process                   process                   "Process"                   }
  {Thread                    thread                    "Thread"                    }
  {Module                    module                    "Module"                    }
  {EntryPoint                entry_point               "Entry Point"               }
  {LaunchMsgID               launch_msg_id             "Launch Message ID"         }
  {DebugInfoPath             debug_info_path           "Debug Info Path"           }
  {PendingThreadName         pending_thread_name       "Pending Thread Name"       }
  {PendingThreadColor        pending_thread_color      "Pending Thread Color"      }
  {Breakpoint                breakpoint                "Breakpoint"                }
  {AddressRangeAnnotation    address_range_annotation  "Address Range Annotation"  }
}

@enum D_EntityKind:
{
  Null,
  @expand(D_EntityKindTable a) `$(a.name)`,
  COUNT,
}

@data(String8) d_entity_kind_code_name_table:
{
  `{0}`,
  @expand(D_EntityKindTable a) `str8_lit_comp("$(a.code_name)")`
}

@data(String8) d_entity_kind_display_string_table:
{
  `{0}`,
  @expand(D_EntityKindTable a) `str8_lit_comp("$(a.display_name)")`
}

////////////////////////////////
//~ rjf: Exception Codes

@enum D_ExceptionCodeKind:
{
  Null,
  @expand(W32_ExceptionCodeKindTable a) `Win32$(a.name)`,
  @expand(LNX_SignalCodeTable a) `Linux$(a.name)`,
  COUNT,
}

@data(U32) d_exception_code_kind_code_table:
{
  `0`;
  @expand(W32_ExceptionCodeKindTable a) `$(a.code)`;
  @expand(LNX_SignalCodeTable a) `$(a.code)`,
}

@data(OperatingSystem) d_exception_code_kind_os_table:
{
  `OperatingSystem_Null`;
  @expand(W32_ExceptionCodeKindTable a) `OperatingSystem_Windows`;
  @expand(LNX_SignalCodeTable a) `OperatingSystem_Linux`,
}

@data(String8) d_exception_code_kind_display_string_table:
{
  `{0}`;
  @expand(W32_ExceptionCodeKindTable a) `str8_lit_comp("$(a.display_string)")`;
  @expand(LNX_SignalCodeTable a) `str8_lit_comp("$(a.name) ($(a.desc))")`,
}

@data(String8) d_exception_code_kind_lowercase_code_string_table:
{
  `{0}`;
  @expand(W32_ExceptionCodeKindTable a) `str8_lit_comp("win32_$(a.lower_name)")`;
  @expand(LNX_SignalCodeTable a) `str8_lit_comp("linux_$(a.name_lower)")`,
}

@data(B8) d_exception_code_kind_default_enable_table:
{
  `0`;
  @expand(W32_ExceptionCodeKindTable a) `$(a.default)`;
  @expand(LNX_SignalCodeTable a) `$(a.break_default)`;
}

////////////////////////////////
//~ rjf: Vocabulary

@table(single plural) D_VocabInfoTable:
{
  {server   _         }
  {process  processes }
  {module   _         }
  {thread   _         }
}

@data(D_VocabInfo) d_vocab_info_table:
{
  @expand(D_VocabInfoTable a) `{str8_lit_comp("$(a.single)"), str8_lit_comp("$(a.plural == '_' -> a.single .. 's')$(a.plural != '_' -> a.plural)")}`
}

////////////////////////////////
//~ rjf: Evaluation Schemas
//
// Each schema defines partial type info for evaluation. It is "partial"
// because sometimes the actual type info of an evaluation is decided
// dynamically, because it is plugging the evaluation system into a
// built-in concept. For example, if I write `some_process.id`, that
// will result in a value-mode evaluation of the ID of `some_process`,
// which comes directly from the debug entity state. On the other hand,
// if I write `some_process.threads`, that will just result in a `threads`
// set type, value-mode, evaluation, of `some_process`, and so that can
// be completely specified here.
//
// Members which are decided procedurally by built-in mechanisms have
// no types specified, e.g. the `name` fields of debug entities. Members
// which have types specified, e.g. `processes:set`, are completely
// automatically wired up from here - no additional code is needed
// (but any non-set member accesses, or any indexing accesses of a set,
// need to be wired up in the code).
//
// If you add a new member here, and you need to write some actual code
// to plug it into the evaluation system, just do not specify a type,
// and adjust the debug engine's driving of the eval compiler (i.e. in
// d_eval_from_string).
//
// You may consider that, because a member access may need to just be
// hardwired into the code (because it is plugging in eval to built-in
// concepts), you do not need to specify the member here, and when it
// comes purely to evaluation, that might be true. However, it's also
// important to consider that the UI needs to build expansions of
// evaluations, and it can only do that easily if it has this partial
// type info. So you still need members in these schemas, even if they
// are hardwired in.
//
// NOTE(rjf): search @schema_builtin for implementations of built-in
// members
//

@table(name, schema) D_EntityEvalSchemaTable:
{
  // @schema server, process, module, thread
  {server      `{name, @no_expand active, unattached_processes:set, processes:set}`}
  {process     `{name, id, @no_expand active, modules:set, threads:set, @no_expand memory}`}
  {module      `{exe, dbg, vaddr_range}`}
  {thread      `{name, id, @no_expand active, call_stack:set}`}
}

@table(name, schema) D_CfgEvalSchemaTable:
{
  //- rjf: @schema breakpoint
  {
    breakpoint,
    ```
      @row_commands(enable_cfg, duplicate_cfg, remove_cfg)
      @collection_commands(toggle_breakpoint, add_breakpoint, add_address_breakpoint, add_function_breakpoint, clear_breakpoints)
    {
      label:            @code string,
      condition:        @expr string,
      source_location:  path_pt,
      address_location: @expr string,
      hit_count:        u64,
      address_range_size: @or(0, 1, 2, 4, 8) u64,
      break_on_write:   bool,
      break_on_read:    bool,
      break_on_execute: bool,
      @display_name("Break Selected Thread Only") break_selected_thread_only: bool,
      @no_revert @no_expand @default(1) enabled: bool,
    }
    ```,
  }
  
  //- rjf: @schema target
  {
    target,
    ```
      @row_commands(@cmd_line save_cfg_to_project, enable_cfg, launch_and_run, launch_and_step_into, duplicate_cfg, remove_cfg)
      @collection_commands(add_target)
    {
      label:              @code string,
      executable:         path,
      arguments:          string,
      working_directory:  @folder path,
      entry_point:        @expr string,
      @default("output") output_label: @code string,
      stdout_path:        @can_not_exist @no_relativize path,
      stderr_path:        @can_not_exist @no_relativize path,
      stdin_path:         @can_not_exist @no_relativize path,
      environment:        set,
      debug_subprocesses: bool,
      @display_name("Remote")
        remote: bool,
      @expand_if("$.remote") @display_name("Deploy")
        deploy: bool,
      @expand_if("$.remote") @display_name("Address")
        address: string,
      @no_revert @no_expand @default(0) enabled: bool,
    }
    ```
  }
}

@struct D_SchemaInfo:
{
  `String8 name`;
  `String8 schema`;
}

@data(D_SchemaInfo) d_entity_schema_info_table:
{
  @expand(D_EntityEvalSchemaTable a) `{str8_lit_comp("$(a.name)"), str8_lit_comp("$(a.schema)")}`,
}

@data(D_SchemaInfo) d_cfg_schema_info_table:
{
  @expand(D_CfgEvalSchemaTable a) `{str8_lit_comp("$(a.name)"), str8_lit_comp("$(a.schema)")}`,
}
